# Yahoo member site configuration. Never commit real values.
YAHOO_LOGIN_ENABLED=false
APP_ORIGIN=https://your-preview.example
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must be confirmed for the provisioned Yahoo app, e.g. openid + approved Fantasy Read.
YAHOO_SCOPES=
# 32 random bytes, base64-encoded; independent from the archive and Yahoo credentials.
SESSION_KEY=
# X25519 PKCS8 private key, server-only; no shared site password is supported.
DATA_PRIVATE_KEY=
# Actual current-season Yahoo game key + .l.844486; verify from live sync.
SCFL_LEAGUE_KEY=
